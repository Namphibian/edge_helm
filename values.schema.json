{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "edge_helm values schema",
  "type": "object",
  "required": [
    "project",
    "configData",
    "ports",
    "services",
    "app"
  ],
  "additionalProperties": true,
  "definitions": {
    "configDataRef": {
      "type": "object",
      "required": [
        "configDataKey"
      ],
      "properties": {
        "configDataKey": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$",
          "description": "Supports dotted sub-fields like buyboostOpenapiHost.host"
        }
      },
      "additionalProperties": false
    },
    "egressPortRef": {
      "type": "object",
      "required": [
        "configDataKey"
      ],
      "properties": {
        "configDataKey": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*\\.port$",
          "description": "Must reference the .port sub-field of a url-type configData entry (e.g. buyboostOpenapiHost.port)"
        }
      },
      "additionalProperties": false
    },
    "portDefinitionRef": {
      "type": "object",
      "required": [
        "portDefinitionKey"
      ],
      "properties": {
        "portDefinitionKey": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$",
          "description": "Supports dotted sub-fields like buyboostOpenapiHost.port"
        }
      },
      "additionalProperties": false
    },
    "portLookupRef": {
      "type": "object",
      "required": [
        "portDefinitionKey"
      ],
      "properties": {
        "portDefinitionKey": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        }
      },
      "additionalProperties": false
    },
    "dnsLabel": {
      "type": "string",
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
      "maxLength": 63
    },
    "k8sPortName": {
      "type": "string",
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
      "maxLength": 15
    },
    "absolutePath": {
      "type": "string",
      "pattern": "^/.*"
    },
    "relativeFilePath": {
      "type": "string",
      "pattern": "^[^/].*"
    },
    "ipv4": {
      "type": "string",
      "pattern": "^(?:25[0-5]|2[0-4][0-9]|1?[0-9]{1,2})(?:\\.(?:25[0-5]|2[0-4][0-9]|1?[0-9]{1,2})){3}$"
    },
    "hostnameOrIpv4": {
      "type": "string",
      "anyOf": [
        {
          "pattern": "^(?:25[0-5]|2[0-4][0-9]|1?[0-9]{1,2})(?:\\.(?:25[0-5]|2[0-4][0-9]|1?[0-9]{1,2})){3}$"
        },
        {
          "pattern": "^(?:[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)(?:\\.(?:[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?))*$"
        }
      ]
    },
    "portNumber": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        {
          "type": "string",
          "pattern": "^([1-9][0-9]{0,4})$"
        }
      ]
    },
    "ipOrRef": {
      "oneOf": [
        {
          "$ref": "#/definitions/ipv4"
        },
        {
          "$ref": "#/definitions/configDataRef"
        }
      ]
    },
    "portOrRef": {
      "oneOf": [
        {
          "$ref": "#/definitions/portNumber"
        },
        {
          "$ref": "#/definitions/portDefinitionRef"
        }
      ]
    },
    "mapOrLiteralPortInt": {
      "oneOf": [
        {
          "type": "integer"
        },
        {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        {
          "$ref": "#/definitions/configDataRef"
        },
        {
          "$ref": "#/definitions/portDefinitionRef"
        }
      ]
    },
    "mapOrLiteralPortConfigOnly": {
      "oneOf": [
        {
          "type": "integer"
        },
        {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        {
          "$ref": "#/definitions/configDataRef"
        },
        {
          "$ref": "#/definitions/portRange"
        }
      ]
    },
    "portRange": {
      "type": "object",
      "required": ["range"],
      "properties": {
        "range": {
          "type": "object",
          "required": ["start", "end"],
          "properties": {
            "start": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "end": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "mapOrLiteralPortLookup": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/definitions/portLookupRef"
        }
      ]
    },
    "mapOrLiteralString": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/definitions/configDataRef"
        }
      ]
    },
    "mapOrLiteralInt": {
      "oneOf": [
        {
          "type": "integer"
        },
        {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        {
          "$ref": "#/definitions/configDataRef"
        }
      ]
    },
    "mapOrLiteralAny": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "integer"
        },
        {
          "type": "boolean"
        },
        {
          "type": "array"
        },
        {
          "$ref": "#/definitions/configDataRef"
        }
      ]
    },
    "annotationValue": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "integer"
        },
        {
          "type": "boolean"
        },
        {
          "$ref": "#/definitions/configDataRef"
        }
      ]
    },
    "configDataEntry": {
      "type": "object",
      "required": [
        "description",
        "value",
        "type"
      ],
      "properties": {
        "description": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "int",
            "string",
            "list",
            "url"
          ]
        },
        "value": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "boolean"
            },
            {
              "type": "array"
            },
            {
              "type": "object"
            }
          ]
        },
        "joinChar": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4,
          "description": "Optional delimiter for list -> string env rendering"
        }
      },
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "list"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "array"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "url"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "object",
                "required": [
                  "host"
                ],
                "properties": {
                  "scheme": {
                    "type": "string",
                    "enum": [
                      "http",
                      "https"
                    ]
                  },
                  "host": {
                    "$ref": "#/definitions/hostnameOrIpv4"
                  },
                  "port": {
                    "$ref": "#/definitions/portNumber"
                  },
                  "path": {
                    "type": "string",
                    "pattern": "^/.*"
                  }
                },
                "additionalProperties": false
              }
            }
          }
        }
      ]
    },
    "servicePortLink": {
      "type": "object",
      "required": [
        "sourcePort",
        "targetPort"
      ],
      "properties": {
        "sourcePort": {
          "$ref": "#/definitions/mapOrLiteralPortLookup"
        },
        "targetPort": {
          "$ref": "#/definitions/mapOrLiteralPortLookup"
        }
      },
      "additionalProperties": false
    },
    "serviceDefRoutable": {
      "type": "object",
      "required": [
        "targetApps",
        "ports"
      ],
      "properties": {
        "description": {
          "type": "string"
        },
        "targetApps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/dnsLabel"
          }
        },
        "exposedRoute": {
          "type": "boolean"
        },
        "annotations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ports": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/servicePortLink"
          }
        }
      },
      "additionalProperties": true
    },
    "serviceDefNonRoutable": {
      "type": "object",
      "required": [
        "targetApps",
        "ports"
      ],
      "properties": {
        "description": {
          "type": "string"
        },
        "targetApps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/dnsLabel"
          }
        },
        "annotations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ports": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/servicePortLink"
          }
        }
      },
      "additionalProperties": true
    },
    "serviceDefExternalName": {
      "type": "object",
      "required": [
        "externalName"
      ],
      "properties": {
        "description": {
          "type": "string"
        },
        "externalName": {
          "type": "string",
          "minLength": 1
        },
        "annotations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "serviceDefHeadless": {
      "type": "object",
      "required": [
        "ports"
      ],
      "properties": {
        "description": {
          "type": "string"
        },
        "annotations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ports": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/servicePortLink"
          }
        }
      },
      "additionalProperties": true
    },
    "probeTypeDef": {
      "type": "object",
      "properties": {
        "tcpSocket": {
          "type": "object",
          "required": [
            "port"
          ],
          "properties": {
            "port": {
              "$ref": "#/definitions/mapOrLiteralPortInt"
            }
          },
          "additionalProperties": false
        },
        "httpGet": {
          "type": "object",
          "required": [
            "path",
            "port"
          ],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^/.*"
            },
            "port": {
              "$ref": "#/definitions/mapOrLiteralPortInt"
            }
          },
          "additionalProperties": false
        },
        "exec": {
          "type": "object",
          "required": [
            "command"
          ],
          "properties": {
            "command": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "anyOf": [
        {
          "required": [
            "tcpSocket"
          ]
        },
        {
          "required": [
            "httpGet"
          ]
        },
        {
          "required": [
            "exec"
          ]
        }
      ],
      "additionalProperties": false
    },
    "probe": {
      "type": "object",
      "required": [
        "probeType",
        "initialDelaySeconds",
        "periodSeconds",
        "timeoutSeconds",
        "failureThreshold"
      ],
      "properties": {
        "probeType": {
          "type": "string"
        },
        "initialDelaySeconds": {
          "type": "integer"
        },
        "periodSeconds": {
          "type": "integer"
        },
        "timeoutSeconds": {
          "type": "integer"
        },
        "failureThreshold": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "project": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "$ref": "#/definitions/dnsLabel"
        },
        "displayName": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "environment": {
          "type": "string"
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "quota": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "hard": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "configData": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/definitions/configDataEntry"
      }
    },
    "ports": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "port",
          "name",
          "protocol"
        ],
        "properties": {
          "port": {
            "$ref": "#/definitions/mapOrLiteralPortConfigOnly"
          },
          "name": {
            "type": "string"
          },
          "protocol": {
            "type": "string",
            "enum": [
              "TCP",
              "UDP",
              "SCTP"
            ]
          },
          "description": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "services": {
      "type": "object",
      "properties": {
        "clusterIp": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/serviceDefRoutable"
          }
        },
        "nodePort": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/serviceDefNonRoutable"
          }
        },
        "loadBalancer": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/serviceDefNonRoutable"
          }
        },
        "externalName": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/serviceDefExternalName"
          }
        },
        "headless": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/serviceDefHeadless"
          }
        }
      },
      "additionalProperties": false
    },
    "persistence": {
      "type": "object",
      "description": "Global persistence definitions (templates) referenced by app volumes",
      "properties": {
        "pvc": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["storageClass", "accessMode", "size"],
            "properties": {
              "annotations": {
                "type": "array",
                "items": { "type": "string" }
              },
              "backup": {
                "type": "object",
                "properties": {
                  "enabled": { "type": "boolean" },
                  "frequency": { "type": "string" },
                  "retention": { "type": "integer", "minimum": 1 },
                  "annotations": {
                    "type": "array",
                    "items": { "type": "string" }
                  }
                },
                "additionalProperties": true
              },
              "storageClass": { "type": "string" },
              "accessMode": { "type": "string" },
              "size": { "type": "string" }
            },
            "additionalProperties": true
          }
        },
        "emptyDir": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "annotations": {
                "type": "array",
                "items": { "type": "string" }
              },
              "medium": {
                "type": "string",
                "enum": ["", "Memory"]
              },
              "sizeLimit": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "annotationSets": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "$ref": "#/definitions/annotationValue"
        }
      }
    },
    "app": {
      "type": "object",
      "required": [],
      "properties": {
        "image": {
          "type": "object",
          "required": [
            "repository",
            "tag",
            "pullPolicy"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\s]+$"
            },
            "tag": {
              "type": "string"
            },
            "pullPolicy": {
              "type": "string",
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            },
            "imagePullSecrets": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": true
        },
        "deployment": {
          "type": "object",
          "properties": {
            "annotations": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": true
        },
        "route": {
          "type": "object",
          "properties": {
            "annotations": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": true
        },
        "replicaCount": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "$ref": "#/definitions/configDataRef"
            }
          ]
        },
        "resources": {
          "type": "object",
          "required": [
            "qos"
          ],
          "properties": {
            "qos": {
              "type": "string",
              "enum": [
                "Guaranteed",
                "Burstable",
                "BestEffort"
              ]
            },
            "requests": {
              "type": "object",
              "properties": {
                "memory": {
                  "$ref": "#/definitions/mapOrLiteralString"
                },
                "cpu": {
                  "$ref": "#/definitions/mapOrLiteralInt"
                }
              },
              "additionalProperties": true
            },
            "limits": {
              "type": "object",
              "properties": {
                "memory": {
                  "$ref": "#/definitions/mapOrLiteralString"
                },
                "cpu": {
                  "$ref": "#/definitions/mapOrLiteralInt"
                }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        },
        "volumes": {
          "type": "object",
          "description": "Per-app volume mount references to top-level persistence definitions",
          "properties": {
            "pvc": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "required": ["mountPath"],
                "properties": {
                  "annotations": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "Overrides top-level pvc annotations if specified"
                  },
                  "backup": {
                    "type": "object",
                    "properties": {
                      "annotations": {
                        "type": "array",
                        "items": { "type": "string" },
                        "description": "Overrides top-level backup annotations if specified"
                      }
                    },
                    "additionalProperties": false
                  },
                  "mountPath": {
                    "type": "string"
                  },
                  "claimName": {
                    "type": "string",
                    "description": "Optional override for the PVC claim name"
                  }
                },
                "additionalProperties": false
              }
            },
            "emptyDir": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "mountPath": {
                    "type": "string",
                    "description": "Mount path inside the container"
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "initContainers": {
          "type": "object",
          "description": "Init containers to run before the main container",
          "additionalProperties": {
            "type": "object",
            "required": ["image"],
            "properties": {
              "image": { "type": "string" },
              "imagePullPolicy": {
                "type": "string",
                "enum": ["Always", "IfNotPresent", "Never"]
              },
              "command": {
                "type": "array",
                "items": { "type": "string" }
              },
              "args": {
                "type": "array",
                "items": { "type": "string" }
              },
              "env": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["name"],
                  "properties": {
                    "name": { "type": "string" },
                    "value": { "type": "string" },
                    "configDataKey": { "type": "string" }
                  },
                  "additionalProperties": false
                }
              },
              "envFrom": {
                "type": "array",
                "items": { "type": "object" }
              },
              "volumes": {
                "type": "object",
                "description": "Volume mount references (same structure as app-level volumes)",
                "properties": {
                  "pvc": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "object",
                      "required": ["mountPath"],
                      "properties": {
                        "mountPath": { "type": "string" }
                      },
                      "additionalProperties": false
                    }
                  },
                  "emptyDir": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "object",
                      "properties": {
                        "mountPath": {
                          "type": "string",
                          "description": "Mount path inside the init container"
                        }
                      },
                      "additionalProperties": false
                    }
                  }
                },
                "additionalProperties": false
              },
              "resources": {
                "type": "object",
                "properties": {
                  "qos": {
                    "type": "string",
                    "enum": ["Guaranteed", "Burstable", "BestEffort"]
                  },
                  "requests": { "type": "object" },
                  "limits": { "type": "object" }
                },
                "additionalProperties": true
              },
              "securityContext": {
                "type": "object",
                "additionalProperties": true
              }
            },
            "additionalProperties": false
          }
        },
        "containerPorts": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/portLookupRef"
          }
        },
        "probeTypes": {
          "type": "object",
          "properties": {
            "tcpSocket": {
              "type": "object",
              "required": [
                "port"
              ],
              "properties": {
                "port": {
